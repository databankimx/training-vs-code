{
  "name": "Working With Visual Studio Code",
  "folder": "training-vs-code",
  "repoUrl": "https://github.com/databankimx/training-vs-code.git",
  "branch": "dev",
  "requirePowerShell7": false,

  "requirements": [
    { "kind": "winget", "id": "Git.Git", "check": "git",
      "paths": ["%ProgramFiles%\\Git\\cmd\\git.exe"] },
    { "kind": "winget", "id": "Microsoft.VisualStudioCode", "check": "code",
      "paths": ["%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\bin\\code.cmd", "%ProgramFiles%\\Microsoft VS Code\\bin\\code.cmd"] },
    { "kind": "winget", "id": "OpenJS.NodeJS.LTS", "check": "node", "minimum": "24",
      "paths": ["%ProgramFiles%\\nodejs\\node.exe"] },
    { "kind": "buildTools", "id": "Microsoft.VisualStudio.2022.BuildTools", "fallbackFor": ["electron"], "elevated": true }
  ],

  "npm": [
    { "folder": "lesson-runner", "install": "auto", "test": true }
  ],

  "electron": { "folder": "lesson-runner" },

  "vscode": {
    "extensions": [],
    "shellExtensions": true
  },

  "launch": { "kind": "electron", "folder": "lesson-runner", "openRepo": true }
}
